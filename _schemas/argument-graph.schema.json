{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberpunk.church/schemas/argument-graph-v1.json",
  "title": "Argument graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "nodes", "edges"],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nodeType": {
      "enum": [
        "question",
        "claim",
        "hypothesis",
        "evidence",
        "objection",
        "assumption",
        "conclusion"
      ]
    },
    "relationType": {
      "enum": [
        "supports",
        "attacks",
        "contradicts",
        "entails",
        "assumes",
        "depends-on",
        "explains",
        "alternative-to"
      ]
    },
    "belief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["probability", "qualitative", "unknown"]
        },
        "value": {
          "type": ["number", "string"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "probability" }
            }
          },
          "then": {
            "required": ["value"],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "qualitative" }
            }
          },
          "then": {
            "required": ["value"],
            "properties": {
              "value": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "unknown" }
            }
          },
          "then": {
            "not": {
              "required": ["value"]
            }
          }
        }
      ]
    },
    "epistemics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["open", "tentative", "accepted", "rejected", "unknown"]
        },
        "belief": {
          "$ref": "#/$defs/belief"
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "cruxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri-reference"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/nodeType"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "body": {
          "type": "string"
        },
        "epistemics": {
          "$ref": "#/$defs/epistemics"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/relationType"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
